{
  "name": "chatthree-app",
  "version": "0.1.0",
  "private": true,
  "description": "chatThree app: a loopback server and browser UI beside the engine.",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/ui/tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "better-sqlite3": "13.2.0",
    "hono": "4.13.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
